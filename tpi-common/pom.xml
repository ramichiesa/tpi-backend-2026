<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>utnfc.isi.back.tpi</groupId>
        <artifactId>tpi-backend-2026</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>tpi-common</artifactId>
    <packaging>jar</packaging>
    <name>tpi-common</name>
    <description>Libreria comun: formato de errores, excepciones, manejador global, conversor de roles de Keycloak y correlacion</description>

    <dependencies>
        <!-- provided: la libreria las usa para compilar pero no las arrastra a los servicios,
             que ya las declaran por su cuenta. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
            <scope>provided</scope>
        </dependency>
        <!-- Solo por las excepciones de concurrencia/integridad (org.springframework.dao) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <!-- Sin spring-boot-maven-plugin: es un JAR comun, no una aplicacion ejecutable.
         "mvn clean install" desde la raiz lo instala en el repositorio local .m2 -->
</project>
