# Copiar a .env (que NO se sube a GitLab) y reemplazar los valores "cambiar-...".
# Todos los valores de este archivo son ficticios. Ver CONTRATOS.md, seccion 11.

# --- PostgreSQL de negocio (una base, un esquema y un usuario por servicio) ---
POSTGRES_DB=tpi
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar-postgres
ANIMALES_DB_USER=animales_user
ANIMALES_DB_PASSWORD=cambiar-animales
ADOPCIONES_DB_USER=adopciones_user
ADOPCIONES_DB_PASSWORD=cambiar-adopciones
DONACIONES_DB_USER=donaciones_user
DONACIONES_DB_PASSWORD=cambiar-donaciones

# --- Keycloak y su base propia ---
KC_DB_USER=keycloak
KC_DB_PASSWORD=cambiar-keycloak-db
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=cambiar-admin
# Secreto del cliente confidencial adopciones-service (se inyecta en el realm al importarlo)
ADOPCIONES_SERVICE_CLIENT_SECRET=cambiar-secreto-de-servicio
# Contrasenia de los usuarios de prueba adoptante1, adoptante2 y coordinador1 (solo demo)
DEMO_USERS_PASSWORD=cambiar-demo

# --- Mercado Pago: Access Token de la cuenta VENDEDORA DE PRUEBA (nunca una cuenta real) ---
MP_ACCESS_TOKEN=cambiar
MP_USAR_SANDBOX_INIT_POINT=false

# --- Georef ---
GEOREF_BASE_URL=https://apis.datos.gob.ar/georef/api/v2.0

# --- Politica de adopcion (valores acordados) ---
REFUGIO_LAT=-31.4334
REFUGIO_LON=-64.1918
DISTANCIA_MAX_KM=100
PLAZO_ENTREGA_DIAS=7
# 30 en el uso normal. Para la demostracion se puede poner 0 y registrar el control final al instante.
PERIODO_ADAPTACION_DIAS=30
DONACION_MONTO_MINIMO=1

# --- Datos y documentacion ---
ANIMALES_DATOS_DEMO=true
SWAGGER_ENABLED=true
